local function createActionBtn(text, isPrimary)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.3333, -7, 1, 0)
    b.BackgroundColor3 = isPrimary and Color3.fromRGB(245, 245, 248) or Color3.fromRGB(24, 24, 28)
    b.BackgroundTransparency = isPrimary and 0.08 or 0.25
    b.Text = text
    b.TextColor3 = isPrimary and Color3.fromRGB(15, 15, 17) or Color3.fromRGB(235, 235, 240)
    b.TextSize = 11
    b.Font = Enum.Font.GothamBold
    b.Parent = btnRow

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 9)
    c.Parent = b

    if not isPrimary then
        local s = Instance.new("UIStroke")
        s.Color = Color3.fromRGB(52, 52, 58)
        s.Thickness = 1
        s.Parent = b
    end
    return b
end

