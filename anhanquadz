local function httpRequestGet(url)
    local lastErr = "Không thể kết nối tới máy chủ."

    local reqCandidates = {
        request,
        http_request,
        (syn and syn.request),
        (http and http.request),
        (fluxus and fluxus.request),
        (krnl and krnl.request)
    }

    for _, reqFn in ipairs(reqCandidates) do
        if type(reqFn) == "function" then
            local ok, res = pcall(function()
                return reqFn({
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["User-Agent"] = "Mozilla/5.0"
                    }
                })
            end)
            if ok and type(res) == "table" then
                local body = res.Body or res.body
                if body and tostring(body) ~= "" then
                    return true, tostring(body)
                end
                lastErr = "HTTP " .. tostring(res.StatusCode or res.status or "?") .. " (Body rỗng)"
            elseif not ok then
                lastErr = tostring(res)
            end
        end
    end

    local okGet, resGet = pcall(function()
        return game:HttpGet(url, true)
    end)
    if okGet and resGet and tostring(resGet) ~= "" then
        return true, tostring(resGet)
    elseif not okGet then
        lastErr = tostring(resGet)
    end

    return false, lastErr
end

local function resolveLocalAsset(fileName)
    if getcustomasset and fileName and fileName ~= "" and isfile and isfile(fileName) then
        local ok, asset = pcall(getcustomasset, fileName)
