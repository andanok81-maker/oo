getKeyBtn.MouseButton1Click:Connect(function()
    local copied = copyText(GET_KEY_URL)
    if copied then
        statusLabel.Text = "Đã copy link lấy key: " .. GET_KEY_URL
        showToast("ANDZ đã sao chép link vượt key vào bộ nhớ tạm")
    else
        keyInput.Text = GET_KEY_URL
        statusLabel.Text = "Hãy copy link từ ô nhập: " .. GET_KEY_URL
        showToast("Đã điền link lấy key vào ô nhập")
    end
end)

pasteKeyBtn.MouseButton1Click:Connect(function()
    local clip = pasteText()
    if clip and tostring(clip) ~= "" then
        local cleaned = tostring(clip):gsub("^%s+", ""):gsub("%s+$", "")
        keyInput.Text = cleaned
        statusLabel.Text = "Đã dán key thành công."
        showToast("ANDZ đã dán dữ liệu từ bảng nhớ tạm của bạn")
    else
        statusLabel.Text = "Không đọc được bảng nhớ tạm hoặc đang trống."
        showToast("Không thể dán tự động, hãy dán thủ công vào ô nhập")
    end
end)

saveKeyBtn.MouseButton1Click:Connect(function()
    local k = keyInput.Text:gsub("%s+", "")
    if k == "" then
        statusLabel.Text = "Vui lòng nhập key trước khi lưu."
        showToast("Chưa có key để lưu")
        return
    end
    saveKeyToFile(k)
    statusLabel.Text = "Đã lưu key thành công."
    showToast("ANDZ đã lưu key của bạn")
end)

local checking = false
loginBtn.MouseButton1Click:Connect(function()
    if checking then return end
    local k = keyInput.Text:gsub("%s+", "")
    if k == "" then
        statusLabel.Text = "Vui lòng nhập key kích hoạt."
        showToast("Key không được để trống")
        return
    end

    checking = true
    loginBtn.Text = "ĐANG KIỂM TRA..."
    statusLabel.Text = "Đang kết nối tới máy chủ xác thực..."

    task.spawn(function()
        local hwid = getHWID()
        local sep = API_URL:find("?", 1, true) and "&" or "?"
        local fullUrl = API_URL .. sep .. "key=" .. urlEncode(k) .. "&hwid=" .. urlEncode(hwid)

        local ok, body = httpRequestGet(fullUrl)
        checking = false
        loginBtn.Text = "ĐĂNG NHẬP"

        if not ok then
            statusLabel.Text = body
            showToast("Lỗi kết nối API")
            return
        end

        local lowerBody = body:lower()
        local isValid = lowerBody:find('"valid"%s*:%s*true')
            or lowerBody:find('"status"%s*:%s*"success"')
            or lowerBody:find('"success"%s*:%s*true')
            or (body:gsub("%s+", ""):lower() == "valid")
            or (body:gsub("%s+", ""):lower() == "success")

        if isValid then
            keyInfoState.Key = k
            keyInfoState.Expires = extractExpiryFromBody(body)
            saveKeyToFile(k)
            statusLabel.Text = "Xác thực thành công! Đang mở menu..."
            showToast("Đăng nhập thành công")
            task.wait(0.6)
            screenGui:Destroy()
            openMainHub()
        else
            local msg = body:match('"message"%s*:%s*"([^"]+)"')
                or body:match('"msg"%s*:%s*"([^"]+)"')
                or "Key không hợp lệ hoặc đã hết hạn."
            statusLabel.Text = msg
            showToast(msg)
        end
    end)
end)
