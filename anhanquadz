local function updateGuiLine(frame, p1, p2)
    local dx = p2.X - p1.X
    local dy = p2.Y - p1.Y
    local dist = math.sqrt(dx * dx + dy * dy)
    if dist < 2 or dist > 2500 then
        frame.Visible = false
        return
    end
    frame.Size = UDim2.fromOffset(dist, 1.5)
    frame.Position = UDim2.fromOffset((p1.X + p2.X) * 0.5, (p1.Y + p2.Y) * 0.5)
    frame.Rotation = math.deg(math.atan2(dy, dx))
    frame.Visible = true
end

local flyBodyVel = nil
local flyBodyGyro = nil

local function cleanupFly()
    if flyBodyVel then
        pcall(function() flyBodyVel:Destroy() end)
        flyBodyVel = nil
    end
    if flyBodyGyro then
        pcall(function() flyBodyGyro:Destroy() end)
        flyBodyGyro = nil
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.PlatformStand = false end)
    end
end

local function updateFlyAndSpeed()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp or not hum or hum.Health <= 0 then
        cleanupFly()
        return
    end

    if miscState.Speed then
        hum.WalkSpeed = miscState.WalkSpeed
    else
        hum.WalkSpeed = defaultWalkSpeed
    end

    if miscState.Fly then
        hum.PlatformStand = true
        if not flyBodyVel or flyBodyVel.Parent ~= hrp then
            cleanupFly()
            hum.PlatformStand = true
            flyBodyVel = Instance.new("BodyVelocity")
            flyBodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyBodyVel.Velocity = Vector3.zero
            flyBodyVel.Parent = hrp

            flyBodyGyro = Instance.new("BodyGyro")
            flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            flyBodyGyro.P = 9e4
            flyBodyGyro.CFrame = hrp.CFrame
            flyBodyGyro.Parent = hrp
        end

        local cam = workspace.CurrentCamera
        local moveDir = hum.MoveDirection
        local vel = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local lookFlat = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
            local forward = Vector3.new(lookFlat.X, 0, lookFlat.Z)
            if forward.Magnitude > 0.001 then
                forward = forward.Unit
                local right = Vector3.new(-forward.Z, 0, forward.X)
                local fwdAmt = moveDir:Dot(forward)
                local rightAmt = moveDir:Dot(right)
                local aimDir = (cam.CFrame.LookVector * fwdAmt + right * rightAmt)
                if aimDir.Magnitude > 0.001 then
                    vel = aimDir.Unit * miscState.FlySpeed
                end
            else
                vel = moveDir.Unit * miscState.FlySpeed
            end
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
            vel = vel + Vector3.new(0, miscState.FlySpeed, 0)
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
            vel = vel - Vector3.new(0, miscState.FlySpeed, 0)
        end

        flyBodyVel.Velocity = vel
        if cam then
            flyBodyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + cam.CFrame.LookVector)
        end
    else
        cleanupFly()
    end
end

RunService.RenderStepped:Connect(function()
    updateFlyAndSpeed()

    Camera = workspace.CurrentCamera
    if not Camera then return end

    local vp = Camera.ViewportSize
    local centerScreen = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local originLine = Vector2.new(vp.X * 0.5, vp.Y)

    fovGuiFrame.Visible = espState.Fov
    fovGuiFrame.Position = UDim2.fromOffset(centerScreen.X, centerScreen.Y)
    fovGuiFrame.Size = UDim2.fromOffset(espState.FovRadius * 2, espState.FovRadius * 2)

    if fovDrawingCircle then
        fovDrawingCircle.Visible = espState.Fov
        fovDrawingCircle.Position = centerScreen
        fovDrawingCircle.Radius = espState.FovRadius
    end

    for plr, item in pairs(playerVisuals) do
        if not plr.Parent or (not espState.Line and not espState.Box) then
            hideEspItem(item)
        else
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if not hrp or not head or not hum or hum.Health <= 0 then
                hideEspItem(item)
            else
                local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if not onScreen or rootPos.Z <= 0 then
                    hideEspItem(item)
                else
                    local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                    local botPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))

                    local height = math.max(12, math.abs(botPos.Y - topPos.Y))
                    local width = math.max(8, height * 0.58)
                    local boxTopLeft = Vector2.new(rootPos.X - width * 0.5, topPos.Y)
                    local footPoint = Vector2.new(rootPos.X, botPos.Y)

                    if espState.Line then
                        if item.drawingLine then
                            item.drawingLine.From = originLine
                            item.drawingLine.To = footPoint
                            item.drawingLine.Visible = true
                            item.guiLine.Visible = false
                        else
                            updateGuiLine(item.guiLine, originLine, footPoint)
                        end
                    else
                        item.guiLine.Visible = false
                        if item.drawingLine then item.drawingLine.Visible = false end
                    end

                    if espState.Box then
                        if item.drawingBox then
                            item.drawingBox.Size = Vector2.new(width, height)
                            item.drawingBox.Position = boxTopLeft
                            item.drawingBox.Visible = true
                            item.guiBox.Visible = false
                        else
                            item.guiBox.Size = UDim2.fromOffset(width, height)
                            item.guiBox.Position = UDim2.fromOffset(boxTopLeft.X, boxTopLeft.Y)
                            item.guiBox.Visible = true
                        end
                    else
                        item.guiBox.Visible = false
                        if item.drawingBox then item.drawingBox.Visible = false end
                    end
                end
            end
        end
    end
end)

