local function urlEncode(str)
    str = tostring(str or "")
    str = str:gsub("\n", "\r\n")
    str = str:gsub("([^%w%-_%.~ ])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
    str = str:gsub(" ", "+")
    return str
end

local function extractExpiryFromBody(body)
    if not body or body == "" then
        return "Không có dữ liệu từ API"
    end

    local patterns = {
        '"expires_at"%s*:%s*"([^"]+)"',
        '"expire_at"%s*:%s*"([^"]+)"',
        '"expires"%s*:%s*"([^"]+)"',
        '"expired_at"%s*:%s*"([^"]+)"',
        '"expiry"%s*:%s*"([^"]+)"',
        '"exp"%s*:%s*"([^"]+)"',
        '"time_left"%s*:%s*"([^"]+)"',
        '"remaining"%s*:%s*"([^"]+)"'
    }

    for _, pat in ipairs(patterns) do
        local val = body:match(pat)
        if val and val ~= "" then
            return val
        end
    end

    local numPat = {
        '"expires_at"%s*:%s*(%d+)',
        '"expire_at"%s*:%s*(%d+)',
        '"expires"%s*:%s*(%d+)',
        '"exp"%s*:%s*(%d+)'
    }
    for _, pat in ipairs(numPat) do
        local num = body:match(pat)
        if num then
            local ts = tonumber(num)
            if ts and ts > 1600000000 then
                local okDate, formatted = pcall(function()
                    return os.date("%d/%m/%Y %H:%M:%S", ts)
                end)
                if okDate and formatted then
                    return tostring(formatted)
                end
            end
            return tostring(num)
        end
    end

    return "API không trả về hạn key"
end

