local function normalizeAssetId(raw)
	local s = tostring(raw or ""):gsub("%s+", "")
	if s == "" then return nil end
	if s:match("^rbxassetid://%d+$") then
		return s
	end
	local digits = s:match("(%d+)")
	if digits then
		return "rbxassetid://" .. digits
	end
	return nil
end

