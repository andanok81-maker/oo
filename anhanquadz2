local function pulseIsland(badgeText, detailText, accentColor)
	islandBadge.Text = tostring(badgeText or "INFO")
	if detailText then
		islandDetail.Text = tostring(detailText)
	end
	if accentColor then
		islandBadge.TextColor3 = accentColor
		islandStroke.Color = accentColor
	end

	local targetW = isIslandExpanded and 340 or 248
	local targetH = isIslandExpanded and 102 or 36
	local bumpW = targetW + 14
	local bumpH = targetH + 3

	local tBump = TweenService:Create(islandFrame, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, bumpW, 0, bumpH)
	})
	local tSettle = TweenService:Create(islandFrame, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, targetW, 0, targetH)
	})
	tBump:Play()
	tBump.Completed:Connect(function()
		tSettle:Play()
	end)
end

