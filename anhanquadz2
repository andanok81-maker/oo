	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = isPrimary and 1 or 0.85
	stroke.Thickness = 1
	stroke.Parent = btn

	return btn
end

local GetKeyBtn  = createBottomBtn("GetKeyBtn", "GET KEY", true)
local PasteKeyBtn = createBottomBtn("PasteKeyBtn", "DÁN KEY", false)
local SaveKeyBtn  = createBottomBtn("SaveKeyBtn", "LƯU KEY", false)

makeDraggable(FloatButton)
makeDraggable(MainWindow, TopBar)

local isBusy = false
local isMinimized = false

local function setStatus(msg, color)
	StatusLabel.Text = tostring(msg)
	StatusLabel.TextColor3 = color or Color3.fromRGB(210, 218, 230)
end

local function submitKey(rawKey, autoMode)
	if isBusy then return end
	local cleanKey = tostring(rawKey or ""):gsub("%s+", "")
	if cleanKey == "" then
		if not autoMode then
			setStatus("Vui lòng nhập key trước khi đăng nhập.", Color3.fromRGB(255, 120, 120))
			pulseIsland("NO KEY", "Chưa nhập key kích hoạt", Color3.fromRGB(255, 110, 110))
		end
		return
	end

	isBusy = true
	LoginBtn.Text = "ĐANG CHECK..."
	setStatus("Đang kiểm tra key qua máy chủ ANDZ...", Color3.fromRGB(145, 210, 255))
	pulseIsland("CHECKING", "Đang xác thực key...", Color3.fromRGB(145, 210, 255))

	local valid, msg = verifyKeyApi(cleanKey)

	LoginBtn.Text = "ĐĂNG NHẬP"
	isBusy = false

	if valid then
		KeyDot.BackgroundColor3 = Color3.fromRGB(70, 235, 130)
		saveKeyFile(cleanKey)
		setStatus(msg, Color3.fromRGB(115, 245, 160))
		task.wait(0.3)
		ScreenGui:Destroy()
		openMainHub(cleanKey)
	else
		KeyDot.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
		if autoMode then
			clearSavedKeyFile()
		end
		setStatus(msg, Color3.fromRGB(255, 115, 115))
		pulseIsland("INVALID", msg, Color3.fromRGB(255, 110, 110))
	end
end

LoginBtn.MouseButton1Click:Connect(function()
	submitKey(KeyTextBox.Text, false)
end)

KeyTextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		submitKey(KeyTextBox.Text, false)
	end
end)

GetKeyBtn.MouseButton1Click:Connect(function()
	local copied = false
	pcall(function()
		if setclipboard then
			setclipboard(ANDZ_GET_KEY_URL)
			copied = true
		elseif toclipboard then
			toclipboard(ANDZ_GET_KEY_URL)
			copied = true
		end
	end)
	if copied then
		setStatus("Đã sao chép link Get Key: " .. ANDZ_GET_KEY_URL, Color3.fromRGB(130, 225, 255))
		pulseIsland("COPIED", "Đã sao chép link Get Key", Color3.fromRGB(120, 220, 255))
	else
		setStatus("Link Get Key: " .. ANDZ_GET_KEY_URL, Color3.fromRGB(130, 225, 255))
	end
end)

PasteKeyBtn.MouseButton1Click:Connect(function()
	local clip = nil
	pcall(function()
		if getclipboard then
			clip = getclipboard()
		end
	end)
	if clip and tostring(clip):gsub("%s+", "") ~= "" then
		KeyTextBox.Text = tostring(clip):gsub("%s+", "")
		setStatus("Đã dán key từ bộ nhớ tạm.", Color3.fromRGB(160, 235, 190))
		pulseIsland("PASTED", "Đã dán key từ clipboard", Color3.fromRGB(115, 245, 160))
	else
		setStatus("Không đọc được bộ nhớ tạm hoặc clipboard trống.", Color3.fromRGB(255, 150, 120))
	end
end)

SaveKeyBtn.MouseButton1Click:Connect(function()
	local cleanKey = tostring(KeyTextBox.Text or ""):gsub("%s+", "")
	if cleanKey == "" then
		setStatus("Chưa có key nào để lưu.", Color3.fromRGB(255, 120, 120))
		return
	end
	saveKeyFile(cleanKey)
	setStatus("Đã lưu key vào " .. ANDZ_SAVE_FILE, Color3.fromRGB(130, 225, 255))
	pulseIsland("SAVED", "Đã lưu key thành công", Color3.fromRGB(120, 220, 255))
end)

MinBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	MainWindow.Visible = not isMinimized
end)

CloseBtn.MouseButton1Click:Connect(function()
	MainWindow.Visible = false
end)

FloatButton.MouseButton1Click:Connect(function()
	MainWindow.Visible = not MainWindow.Visible
	isMinimized = not MainWindow.Visible
end)

local savedKey = loadSavedKeyFile()
if savedKey then
	KeyTextBox.Text = savedKey
	setStatus("Đã tự động tải key đã lưu.", Color3.fromRGB(185, 225, 255))
	pulseIsland("AUTO KEY", "Đang tự động kiểm tra key đã lưu...", Color3.fromRGB(145, 210, 255))
	task.spawn(function()
		task.wait(0.25)
		submitKey(savedKey, true)
	end)
end
