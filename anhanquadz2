local function urlEncode(str)
	str = tostring(str or "")
	str = str:gsub("\n", "\r\n")
	str = str:gsub("([^%w%-_%.~ ])", function(c)
		return string.format("%%%02X", string.byte(c))
	end)
	str = str:gsub(" ", "+")
	return str
end

local function httpGetBody(url)
	local lastErr = "Không thể kết nối tới máy chủ."
	local reqList = {
		request,
		http_request,
		(syn and syn.request),
		(http and http.request),
		(fluxus and fluxus.request),
		(krnl and krnl.request)
	}

	for _, reqFn in ipairs(reqList) do
		if type(reqFn) == "function" then
			local ok, res = pcall(function()
				return reqFn({
					Url = url,
					Method = "GET",
					Headers = {
						["User-Agent"] = "Mozilla/5.0"
					}
				})
			end)
			if ok and type(res) == "table" then
				local body = res.Body or res.body
				if body and tostring(body) ~= "" then
					return true, tostring(body)
				end
				lastErr = "HTTP " .. tostring(res.StatusCode or res.status or "?")
			elseif not ok then
				lastErr = tostring(res)
			end
		end
	end

	local okGet, resGet = pcall(function()
		return game:HttpGet(url, true)
	end)
	if okGet and resGet and tostring(resGet) ~= "" then
		return true, tostring(resGet)
	elseif not okGet then
		lastErr = tostring(resGet)
	end

	return false, lastErr
end

local function verifyKeyApi(key)
	local hwid = getHWID()
	local sep = ANDZ_API_URL:find("?", 1, true) and "&" or "?"
	local url = ANDZ_API_URL .. sep .. "key=" .. urlEncode(key) .. "&hwid=" .. urlEncode(hwid)

	local ok, body = httpGetBody(url)
	if not ok then
		return false, "Lỗi kết nối: " .. tostring(body)
	end

	local lower = body:lower()
	local valid = lower:find('"valid"%s*:%s*true')
		or lower:find('"status"%s*:%s*"success"')
		or lower:find('"success"%s*:%s*true')
		or (body:gsub("%s+", ""):lower() == "valid")
		or (body:gsub("%s+", ""):lower() == "success")

	local msg = body:match('"message"%s*:%s*"([^"]+)"')
		or body:match('"msg"%s*:%s*"([^"]+)"')
		or (valid and "Xác thực key thành công!" or "Key không hợp lệ hoặc đã hết hạn.")

	return valid, msg
end

